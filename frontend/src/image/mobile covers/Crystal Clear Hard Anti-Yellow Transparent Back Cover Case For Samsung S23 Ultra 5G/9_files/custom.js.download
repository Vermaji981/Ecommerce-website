(async function(){function norm(s){return(s||"").toString().trim().toLowerCase().replace(/\s+/g," ")}function getHandle(){const part=location.pathname.split("/products/")[1];return part?part.split("/")[0]:null}function getUrlVariant(){return new URL(location.href).searchParams.get("variant")}function setUrlVariant(id){const u=new URL(location.href);u.searchParams.set("variant",id),history.replaceState({},"",u.toString())}async function loadProduct(handle2){const res=await fetch(`/products/${handle2}.js`,{credentials:"same-origin"});return res.ok?await res.json():null}const handle=getHandle();if(!handle)return;const product=await loadProduct(handle);if(!product||!Array.isArray(product.variants))return;function findSelectByLabelText(labelText){const t=[...document.querySelectorAll("label, .m-product-option, .product-form__input")].find(el=>norm(el.textContent).includes(norm(labelText)));return t?t.querySelector("select")||t.closest("div")?.querySelector("select")||t.parentElement?.querySelector("select"):null}function getOptionTexts(){const modelSel=findSelectByLabelText("compatible model"),colorSel=findSelectByLabelText("colour")||findSelectByLabelText("color");let s1=modelSel,s2=colorSel;if(!s1||!s2){const visibles=[...document.querySelectorAll("select")].filter(s=>s.offsetParent!==null);s1=s1||visibles[0],s2=s2||visibles[1]}if(!s1||!s2)return null;const o1=s1.options[s1.selectedIndex]?.textContent,o2=s2.options[s2.selectedIndex]?.textContent;return{opt1:o1,opt2:o2}}function findVariantId(opt1,opt2){const n1=norm(opt1),n2=norm(opt2);let v=product.variants.find(x=>norm(x.option1)===n1&&norm(x.option2)===n2);return v||(v=product.variants.find(x=>norm(x.option1)===n2&&norm(x.option2)===n1),v)?String(v.id):null}function setVariantIdInForms(variantId){document.querySelectorAll('form[action^="/cart/add"] input[name="id"]').forEach(inp=>{inp.value=variantId,inp.dispatchEvent(new Event("change",{bubbles:!0}))})}const GUARD_KEY="cfc_variant_reload_guard",lastReloadedVariant=